---
import { Image } from 'astro:assets';
import VinylCover from './VinylCover.astro';
import crewneck from '../images/vinyl-night/six-years-crewneck.png';
import felixLogo from '../images/Felix.svg';

interface Track {
  title: string;
  artist: string;
  length: string;
  spotifyId: string;
}

interface Artifact {
  type: 'photo' | 'instagram' | 'video';
  src?: string;
  poster?: string;
  url?: string;
  alt?: string;
  caption?: string;
  credit?: string;
}

interface Night {
  slug: string;
  date: string;
  label: string;
  title?: string;
  time?: string;
  note?: string;
  /** Sleeve colors as [background, ink, accent], usually pulled from the night's flyer. */
  colors?: string[];
  spotifyPlaylistId?: string;
  tracks: Track[];
  artifacts?: Artifact[];
}

interface Props {
  nights: Night[];
  openSlug?: string;
}

const { nights, openSlug } = Astro.props;

const INSTAGRAM = 'https://instagram.com/blackcat.barbershop';
const pad = (n: number) => String(n).padStart(2, '0');

// Shop greens and cream, plus mustard and clay so each volume gets its own sleeve.
const palettes = [
  ['#F4F3E7', '#366951', '#d9b44a'],
  ['#2a5240', '#F4F3E7', '#c8643b'],
  ['#d9b44a', '#2a5240', '#F4F3E7'],
  ['#0c0c0c', '#F4F3E7', '#d9b44a'],
  ['#c8643b', '#F4F3E7', '#2a5240'],
];
// Where artifacts land when they spill out, as % of the area around the spread.
const slots = [
  { x: 8, y: 30, r: -6 },
  { x: 90, y: 30, r: 4 },
  { x: 9, y: 66, r: 5 },
  { x: 34, y: 92, r: -2 },
];
const ticketSlot = { x: 58, y: 11, r: 3 };
const recordSlot = { x: 79, y: 72, r: 0 };
const slot = (i: number, { x, y, r } = slots[i % slots.length]) => `--x:${x}%;--y:${y}%;--r:${r}deg;--i:${i}`;

function runtimeOf(tracks: Track[]) {
  const total = tracks.reduce((sum, t) => {
    const [m, s] = t.length.split(':').map(Number);
    return sum + m * 60 + s;
  }, 0);
  const hours = Math.floor(total / 3600);
  const minutes = Math.round((total % 3600) / 60);
  return hours ? `${hours} hr ${minutes} min` : `${minutes} min`;
}

function monthOf(date: string) {
  return new Date(`${date}T12:00:00`).toLocaleDateString('en-US', { month: 'long' });
}

function longDate(date: string) {
  return new Date(`${date}T12:00:00`).toLocaleDateString('en-US', {
    weekday: 'short',
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}

// Spotify gets the exact track; the rest open a search, so they work without any account on our side.
function otherServices(track: Track) {
  const q = encodeURIComponent(`${track.artist} ${track.title}`.replace(/\//g, ' '));
  return [
    { name: 'Apple', url: `https://music.apple.com/us/search?term=${q}` },
    { name: 'YouTube', url: `https://music.youtube.com/search?q=${q}` },
    { name: 'Tidal', url: `https://tidal.com/search?q=${q}` },
    { name: 'Amazon', url: `https://music.amazon.com/search/${q}` },
  ];
}

function inkOn(hex: string) {
  const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
  return 0.299 * r + 0.587 * g + 0.114 * b > 150 ? '#1f1f1f' : '#f6f2e6';
}

function instagramEmbed(url: string) {
  const path = new URL(url).pathname.replace(/\/?$/, '/');
  return `https://www.instagram.com${path}embed/`;
}

const records = [...nights]
  .sort((a, b) => a.date.localeCompare(b.date))
  .map((night, i) => ({
    ...night,
    vol: pad(i + 1),
    palette: night.colors ?? palettes[i % palettes.length],
    runtime: runtimeOf(night.tracks),
    longDate: longDate(night.date),
    month: monthOf(night.date),
    year: night.date.slice(0, 4),
    sideASize: Math.ceil(night.tracks.length / 2),
    artifacts: night.artifacts ?? [],
    title: night.title ?? 'Vinyl Night',
    playlistUrl: night.spotifyPlaylistId && `https://open.spotify.com/playlist/${night.spotifyPlaylistId}`,
    embedUrl: night.spotifyPlaylistId && `https://open.spotify.com/embed/playlist/${night.spotifyPlaylistId}?theme=0`,
  }))
  .map((r) => ({
    ...r,
    coverFoot: r.tracks.length ? `${r.tracks.length} songs · ${r.runtime}` : [r.time, '6745 Kimball'].filter(Boolean).join(' · '),
  }))
  .reverse();

const openIndex = openSlug ? records.findIndex((r) => r.slug === openSlug) : -1;
const current = Math.max(openIndex, 0);
const nextVol = pad(records.length + 1);
---

<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400&display=swap"
/>

<section
  id="vinyl-night"
  class="stage"
  data-stage
  data-current={current}
  data-open={openIndex >= 0 ? openSlug : undefined}
  aria-label="Black Cat Vinyl Night archive"
>
  <div class="wallpaper" aria-hidden="true">
    <img class="wallpaper-felix" src={felixLogo.src} alt="" width="640" height="640" />
    <div class="wallpaper-wash"></div>
    <div class="wallpaper-noise wallpaper-noise-fine"></div>
    <div class="wallpaper-noise wallpaper-noise-coarse"></div>
  </div>

  <h1 class="backdrop">
    <span class="backdrop-title">Vinyl<br />Night</span>
    <span class="backdrop-meta">Black Cat Barber · 6745 Kimball Dr, Gig Harbor</span>
  </h1>

  <figure class="sticker" aria-hidden="true">
    <img src="/vinyl-night/felix-sticker.jpg" alt="" width="800" height="800" />
  </figure>

  <figure class="pinup" aria-hidden="true">
    <span class="tape" aria-hidden="true"></span>
    <img src="/vinyl-night/scare-the-kids.jpg" alt="" width="813" height="1024" />
  </figure>

  <figure class="merch">
    <Image
      src={crewneck}
      width={640}
      format="webp"
      alt="Black Cat Barbershop “6 Years of Scary Good Cuts” crewneck sweatshirt"
    />
    <a class="merch-tag" href="/#contact">
      <span class="merch-tag-hole" aria-hidden="true"></span>
      <span class="merch-tag-title">For Sale</span>
      <span class="merch-tag-copy">I'm limited edition! Come to the shop and buy me before I'm gone!</span>
    </a>
  </figure>

  <div class="floor" data-floor>
    <div class="crate" data-crate>
      {records.map((r, i) => (
        <button
          type="button"
          class:list={['sleeve', { 'is-top': i === current }]}
          data-sleeve={i}
          style={`--d:${i};z-index:${records.length - i + 1}`}
          aria-label={`Open Vinyl Night ${r.label}`}
        >
          <span class="sleeve-disc" aria-hidden="true">
            <span class="disc-label" style={`--accent:${r.palette[2]}`}>
              <span>Vol. {r.vol}</span>
              <span>{r.label}</span>
            </span>
          </span>
          <VinylCover month={r.month} year={r.year} vol={r.vol} title={r.title} foot={r.coverFoot} palette={r.palette} />
        </button>
      ))}

      <a
        class="sleeve sleeve-tba"
        href={INSTAGRAM}
        target="_blank"
        rel="noopener noreferrer"
        style={`--d:${records.length};z-index:1`}
        tabindex="-1"
        aria-label="Next Vinyl Night, date to be announced. Watch our Instagram."
      >
        <span class="tba-in">
          <span class="tba-stamp">Vol. {nextVol}</span>
          <span class="tba-body">Next Vinyl Night<br />date TBA</span>
          <span class="tba-foot">watch @blackcat.barbershop ↗</span>
        </span>
      </a>

      <p class="crate-hint" data-hint aria-hidden="true">
        <span class="hint-touch">(swipe to dig · tap to open)</span>
        <span class="hint-mouse">(scroll to dig · click to open)</span>
      </p>
    </div>

    {records.map((r, i) => {
      const isOpen = i === openIndex;
      const photoCount = r.artifacts.length;
      return (
        <article
          class:list={['gatefold', { 'is-mounted is-open is-settled is-spilled': isOpen }]}
          data-gatefold={i}
          data-slug={r.slug}
          data-label={r.label}
          data-nav={`${r.longDate} · Vol. ${r.vol}`}
          aria-label={`Vinyl Night ${r.label}, opened`}
        >
          <div class="gf-inner">
            <section class="gf-panel gf-right liner" aria-label={`Liner notes for ${r.title} ${r.label}`}>
              <header class="panel-head">
                <span>Liner notes</span>
              </header>
              <div class="liner-body">
                <p class="liner-title">{r.title}<br />{r.month} {r.year}</p>
                <div class="liner-copy">
                  {r.time && <p>{r.time} · 6745 Kimball Dr, Gig Harbor</p>}
                  {r.note && <p>{r.note}</p>}
                  <p>Bring a record next time.</p>
                </div>
              </div>
              <span class="liner-rings" aria-hidden="true"></span>
            </section>

            <div class="gf-leaf">
              <div class="gf-face gf-front" aria-hidden="true">
                <VinylCover month={r.month} year={r.year} vol={r.vol} title={r.title} foot={r.coverFoot} palette={r.palette} />
              </div>

              <section class="gf-face gf-back gf-panel gf-left" aria-label={`Tracklist for Vinyl Night ${r.label}`}>
                <header class="panel-head tl-head">
                  <span>{r.tracks.length ? `Tracklist · ${r.tracks.length} songs · ${r.runtime}` : 'Tracklist'}</span>
                  <div class="tl-head-actions">
                    {r.playlistUrl && <a href={r.playlistUrl} target="_blank" rel="noopener noreferrer">Spotify ↗</a>}
                    <button type="button" class="paren-btn" data-close aria-label="Close the gatefold">(×)</button>
                  </div>
                </header>

                {r.tracks.length === 0 && (
                  <div class="tl-lost">
                    <p class="tl-lost-title">Side A: ???<br />Side B: ???</p>
                    <p>We didn't write this setlist down. Were you there? Tell us what got played and we'll put it back together.</p>
                    <a href={INSTAGRAM} target="_blank" rel="noopener noreferrer">( DM @blackcat.barbershop ↗ )</a>
                  </div>
                )}

                <ol class="tracklist" hidden={r.tracks.length === 0}>
                  {r.tracks.map((t, j) => (
                    <>
                      {(j === 0 || j === r.sideASize) && <li class="tl-side">{j === 0 ? 'Side A' : 'Side B'}</li>}
                      <li class="tl-row">
                        <a
                          class="tl-play"
                          href={`https://open.spotify.com/track/${t.spotifyId}`}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={`Play ${t.title} by ${t.artist} on Spotify`}
                        >
                          (▸)
                        </a>
                        <span class="tl-text">
                          <span class="tl-title">{t.title}</span>
                          <span class="tl-artist">{t.artist}</span>
                        </span>
                        <span class="tl-len">{t.length}</span>
                        <button
                          type="button"
                          class="paren-btn"
                          data-more
                          aria-expanded="false"
                          aria-label={`More places to play ${t.title}`}
                        >
                          (···)
                        </button>
                        <span class="tl-links">
                          {otherServices(t).map((s) => (
                            <a href={s.url} target="_blank" rel="noopener noreferrer">
                              {s.name} ↗
                            </a>
                          ))}
                        </span>
                      </li>
                    </>
                  ))}
                </ol>

              </section>
            </div>
          </div>

          <div class="spill" aria-label={`Things from ${r.title} ${r.label}`}>
                <div class="artifact artifact-stub" data-artifact style={`${slot(0, ticketSlot)};--stub-bg:${r.palette[0]};--stub-ink:${r.palette[1]};--stub-accent:${r.palette[2]}`}>
                  <span class="stub-admit">Admit one</span>
                  <span class="stub-title">{r.title} · Vol. {r.vol}</span>
                  <span class="stub-date">{r.label}</span>
                  <span class="stub-fine">Black Cat Barber · BYO record · no cover</span>
                </div>

                {r.artifacts.map((a, j) =>
                  a.type === 'video' && a.src ? (
                    <figure class="artifact artifact-video" data-artifact data-zoom style={slot(j)}>
                      <video
                        src={a.src}
                        poster={a.poster}
                        muted
                        loop
                        playsinline
                        preload="none"
                        data-video
                        aria-label={a.alt ?? a.caption ?? `Video from Vinyl Night ${r.label}`}
                      ></video>
                      <button type="button" class="video-sound" data-sound aria-pressed="false">(sound on)</button>
                      <figcaption>
                        {a.url ? (
                          <a href={a.url} target="_blank" rel="noopener noreferrer">{a.caption ?? 'Watch on Instagram'} ↗</a>
                        ) : (
                          a.caption
                        )}
                      </figcaption>
                    </figure>
                  ) : a.type === 'instagram' && a.url ? (
                    <figure class="artifact artifact-ig" data-artifact style={slot(j)}>
                      <span class="artifact-bar" aria-hidden="true"><span>instagram</span><span>(⌄)</span></span>
                      <iframe
                        data-src={instagramEmbed(a.url)}
                        src={isOpen ? instagramEmbed(a.url) : undefined}
                        title={a.caption ?? `Instagram post from Vinyl Night ${r.label}`}
                        height="480"
                        loading="lazy"
                      ></iframe>
                      {a.caption && <figcaption>{a.caption}</figcaption>}
                    </figure>
                  ) : (
                    <figure class="artifact artifact-photo" data-artifact data-zoom style={slot(j)}>
                      <span class="artifact-bar" aria-hidden="true"><span></span><span>(+)</span></span>
                      <img src={a.src} alt={a.alt ?? a.caption ?? `Vinyl Night ${r.label}`} loading="lazy" />
                      {(a.caption || a.credit) && (
                        <figcaption>
                          {a.caption}
                          {a.credit && <span class="credit">Photo: {a.credit}</span>}
                        </figcaption>
                      )}
                    </figure>
                  ),
                )}

                {photoCount < 2 && (
                  <div class="artifact artifact-empty" data-artifact style={slot(photoCount)}>
                    <span>(photo goes here)</span>
                    <span>Got pics from {r.label}? Tag @blackcat.barbershop</span>
                  </div>
                )}

                <div class="artifact artifact-record" data-artifact style={`${slot(photoCount, recordSlot)};--accent:${r.palette[2]};--label-ink:${inkOn(r.palette[2])}`}>
                  <svg class="record-disc" viewBox="0 0 100 100" aria-hidden="true">
                    <defs>
                      <path id={`record-ring-${r.slug}`} d="M50,50 m-22,0 a22,22 0 1,1 44,0 a22,22 0 1,1 -44,0" />
                    </defs>
                    <circle class="record-label" cx="50" cy="50" r="28" />
                    <text class="record-text">
                      <textPath href={`#record-ring-${r.slug}`} textLength="136">
                        Black Cat Barber · Vol. {r.vol} · {r.title} {r.label} ·
                      </textPath>
                    </text>
                    <circle class="record-hole" cx="50" cy="50" r="1.4" />
                  </svg>
                  {r.embedUrl && (
                    <iframe
                      class="record-player"
                      data-src={r.embedUrl}
                      src={isOpen ? r.embedUrl : undefined}
                      title={`Vinyl Night ${r.label} playlist on Spotify`}
                      height="80"
                      loading="lazy"
                      allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                    ></iframe>
                  )}
                </div>
          </div>
        </article>
      );
    })}
  </div>

  <nav class="menu-card" data-menu aria-label="Vinyl Night">
    <div class="menu-tab" data-menu-grip>
      <span>Vinyl Night</span>
      <button type="button" class="paren-btn" data-menu-fold aria-expanded="true" aria-label="Fold the menu">(–)</button>
    </div>
    <div class="menu-body">
      <button type="button" class="menu-primary" data-primary>
        {openIndex >= 0 ? 'CLOSE' : 'OPEN'}
      </button>
      <div class="menu-night">
        <button type="button" class="paren-btn" data-prev aria-label="Previous night" disabled={records.length < 2}>(‹)</button>
        <span data-night-label aria-live="polite">{records[current].longDate} · Vol. {records[current].vol}</span>
        <button type="button" class="paren-btn" data-next aria-label="Next night" disabled={records.length < 2}>(›)</button>
      </div>
      <a href="/" class="menu-brand">Black Cat Barber <span aria-hidden="true">↩</span></a>
      <ul class="menu-links" data-menu-links>
        <li><a href="/vinyl-night/" data-close>The crate <span>({records.length})</span></a></li>
        <li><a href="/#team">Book a cut</a></li>
        <li><a href={INSTAGRAM} target="_blank" rel="noopener noreferrer">Instagram ↗</a></li>
        <li><a href="/#contact">Find the shop</a></li>
      </ul>
    </div>
  </nav>

  <dialog class="lightbox" data-lightbox aria-label="Enlarged artifact">
    <button type="button" class="paren-btn lightbox-close" data-lightbox-close aria-label="Close">(×)</button>
    <figure class="lightbox-figure">
      <div class="lightbox-media" data-lightbox-media></div>
      <figcaption class="lightbox-caption" data-lightbox-caption></figcaption>
    </figure>
  </dialog>
</section>

<script>
  const OPEN_MS = 1100;
  const CLOSE_MS = 900;
  const TUCK_MS = 520;
  const TOSS_MS = 260;
  const WHEEL_THRESHOLD = 30;
  const WHEEL_QUIET_MS = 180;
  const WHEEL_LOCK_MS = 700;

  function initVinylNight(stage: HTMLElement) {
    const sleeves = [...stage.querySelectorAll<HTMLElement>('[data-sleeve]')];
    const folds = [...stage.querySelectorAll<HTMLElement>('[data-gatefold]')];
    const navLabel = stage.querySelector<HTMLElement>('[data-night-label]')!;
    const primary = stage.querySelector<HTMLButtonElement>('[data-primary]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const flat = window.matchMedia('(max-width: 1023.98px)');
    const total = sleeves.length;
    const baseTitle = 'Vinyl Night - Black Cat Barber';

    let current = Number(stage.dataset.current) || 0;
    let order = sleeves.map((_, i) => (current + i) % total);
    let openIndex = stage.dataset.open ? current : -1;
    let flicking = false;
    const timers = new Map<number, number>();
    const floor = stage.querySelector<HTMLElement>('[data-floor]')!;
    const crate = stage.querySelector<HTMLElement>('[data-crate]')!;

    const hint = stage.querySelector<HTMLElement>('[data-hint]');

    const animated = () => !reduce.matches && !flat.matches;

    // Videos only run while their night is open and they are on screen, so a phone
    // doesn't pull the reel down before anyone scrolls to it.
    const inView = new Set<HTMLVideoElement>();
    function syncVideo(video: HTMLVideoElement) {
      const live = inView.has(video) && !!video.closest('.gatefold')?.classList.contains('is-spilled');
      if (live) video.play().catch(() => {});
      else video.pause();
    }
    const watcher = new IntersectionObserver(
      (entries) =>
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) inView.add(video);
          else inView.delete(video);
          syncVideo(video);
        }),
      { threshold: 0.2 },
    );
    stage.querySelectorAll<HTMLVideoElement>('[data-video]').forEach((video) => watcher.observe(video));

    function renderCrate() {
      sleeves.forEach((sleeve, i) => {
        const depth = order.indexOf(i);
        sleeve.style.setProperty('--d', String(depth));
        sleeve.style.zIndex = String(total - depth + 1);
        sleeve.classList.toggle('is-top', depth === 0);
        sleeve.tabIndex = depth === 0 ? 0 : -1;
      });
      navLabel.textContent = folds[current].dataset.nav ?? '';
      primary.textContent = openIndex >= 0 ? 'CLOSE' : 'OPEN';
    }

    function bringToTop(i: number) {
      current = i;
      order = sleeves.map((_, k) => (i + k) % total);
    }

    function loadFrames(fold: HTMLElement) {
      fold.querySelectorAll<HTMLIFrameElement>('iframe[data-src]').forEach((frame) => {
        if (!frame.getAttribute('src')) frame.src = frame.dataset.src!;
      });
    }

    function unmount(i: number) {
      window.clearTimeout(timers.get(i));
      folds[i].classList.remove('is-mounted', 'is-open', 'is-settled', 'is-spilled', 'no-anim');
      tuckArtifacts(folds[i]);
    }

    // Dragged artifacts go back to their own spot next time they spill out.
    function tuckArtifacts(fold: HTMLElement) {
      fold.querySelectorAll<HTMLElement>('[data-artifact]').forEach((card) => {
        card.style.removeProperty('--tx');
        card.style.removeProperty('--ty');
        card.style.zIndex = '';
      });
      fold.querySelectorAll<HTMLVideoElement>('[data-video]').forEach((video) => {
        video.pause();
        video.muted = true;
      });
      fold.querySelectorAll<HTMLButtonElement>('[data-sound]').forEach((btn) => {
        btn.setAttribute('aria-pressed', 'false');
        btn.textContent = '(sound on)';
      });
    }

    function spill(fold: HTMLElement) {
      void fold.offsetWidth;
      fold.classList.add('is-spilled');
      fold.querySelectorAll<HTMLVideoElement>('[data-video]').forEach(syncVideo);
    }

    stage.addEventListener('click', (event) => {
      const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-sound]');
      const video = btn?.closest('figure')?.querySelector<HTMLVideoElement>('[data-video]');
      if (!btn || !video) return;
      video.muted = !video.muted;
      if (video.paused) video.play().catch(() => {});
      btn.setAttribute('aria-pressed', String(!video.muted));
      btn.textContent = video.muted ? '(sound on)' : '(sound off)';
    });

    if (openIndex >= 0) spill(folds[openIndex]);

    function open(i: number, { push = true, animate = animated() } = {}) {
      if (openIndex === i) return;
      hint?.classList.add('is-used');
      if (openIndex >= 0) unmount(openIndex);
      unmount(i);

      const fold = folds[i];
      bringToTop(i);
      openIndex = i;
      stage.dataset.open = fold.dataset.slug;
      fold.classList.add('is-mounted');

      if (animate) {
        void fold.offsetWidth;
        fold.classList.add('is-open');
        timers.set(
          i,
          window.setTimeout(() => {
            fold.classList.add('is-settled');
            loadFrames(fold);
            spill(fold);
          }, OPEN_MS),
        );
      } else {
        fold.classList.add('is-open', 'is-settled');
        loadFrames(fold);
        spill(fold);
      }

      if (push) history.pushState({ slug: fold.dataset.slug }, '', `/vinyl-night/${fold.dataset.slug}/`);
      document.title = `Vinyl Night ${fold.dataset.label} Playlist - Black Cat Barber`;
      renderCrate();
      fold.querySelector<HTMLElement>('[data-close]')?.focus({ preventScroll: true });
      floor.scrollTop = 0;
    }

    function close({ push = true } = {}) {
      if (openIndex < 0) return;
      const i = openIndex;
      const fold = folds[i];
      openIndex = -1;
      window.clearTimeout(timers.get(i));

      if (animated()) {
        // Tuck the artifacts back into the sleeve first, then swap the flattened layout back
        // to the 3D pose without a jump and let it fold shut.
        const wasSpilled = fold.classList.contains('is-spilled');
        fold.classList.remove('is-spilled');
        tuckArtifacts(fold);
        const foldShut = () => {
          if (openIndex < 0) delete stage.dataset.open;
          fold.classList.add('no-anim');
          fold.classList.remove('is-settled');
          void fold.offsetWidth;
          fold.classList.remove('no-anim');
          fold.classList.remove('is-open');
          timers.set(i, window.setTimeout(() => unmount(i), CLOSE_MS));
        };
        if (wasSpilled) timers.set(i, window.setTimeout(foldShut, TUCK_MS));
        else foldShut();
      } else {
        delete stage.dataset.open;
        unmount(i);
      }

      if (push) history.pushState({}, '', '/vinyl-night/');
      document.title = baseTitle;
      renderCrate();
      sleeves[current].focus({ preventScroll: true });
    }

    function step(dir: 1 | -1) {
      if (total < 2) return;
      hint?.classList.add('is-used');
      const next = (current + dir + total) % total;
      if (openIndex >= 0) {
        open(next, { animate: false, push: true });
        return;
      }
      if (flicking) return;
      if (reduce.matches) {
        bringToTop(next);
        renderCrate();
        return;
      }

      flicking = true;
      if (dir === 1) {
        const top = sleeves[current];
        top.classList.add('is-tossing');
        window.setTimeout(() => {
          top.classList.remove('is-tossing');
          bringToTop(next);
          renderCrate();
          flicking = false;
        }, TOSS_MS);
      } else {
        // Going back, the record flies in from where tossed ones leave.
        const incoming = sleeves[next];
        incoming.style.transition = 'none';
        incoming.classList.add('is-tossing');
        bringToTop(next);
        renderCrate();
        void incoming.offsetWidth;
        incoming.style.transition = '';
        incoming.classList.remove('is-tossing');
        window.setTimeout(() => (flicking = false), TOSS_MS);
      }
    }

    // Scrolling flicks through the crate. One flick per gesture, so trackpad momentum doesn't skip records.
    let wheelTotal = 0;
    let wheelLockedAt = 0;
    let lastWheel = 0;
    stage.addEventListener(
      'wheel',
      (event) => {
        if (openIndex >= 0 || event.ctrlKey) return;
        event.preventDefault();
        const now = performance.now();
        const quiet = now - lastWheel > WHEEL_QUIET_MS;
        lastWheel = now;
        if (wheelLockedAt && !quiet && now - wheelLockedAt < WHEEL_LOCK_MS) return;
        wheelLockedAt = 0;
        wheelTotal += event.deltaY + event.deltaX;
        if (Math.abs(wheelTotal) < WHEEL_THRESHOLD) return;
        step(wheelTotal > 0 ? 1 : -1);
        wheelTotal = 0;
        wheelLockedAt = now;
      },
      { passive: false },
    );

    // Swipe the stack up or sideways to flick to the next record, down or back for the last one.
    let touchStart: { x: number; y: number } | null = null;
    let swipedAt = 0;
    crate.addEventListener(
      'touchstart',
      (event) => (touchStart = { x: event.touches[0].clientX, y: event.touches[0].clientY }),
      { passive: true },
    );
    crate.addEventListener(
      'touchend',
      (event) => {
        if (!touchStart) return;
        const dx = touchStart.x - event.changedTouches[0].clientX;
        const dy = touchStart.y - event.changedTouches[0].clientY;
        touchStart = null;
        const d = Math.abs(dx) > Math.abs(dy) ? dx : dy;
        if (Math.abs(d) < 40) return;
        swipedAt = performance.now();
        step(d > 0 ? 1 : -1);
      },
      { passive: true },
    );

    sleeves.forEach((sleeve, i) =>
      sleeve.addEventListener('click', () => {
        // A swipe that ends on a sleeve shouldn't also open it.
        if (performance.now() - swipedAt < 400) return;
        if (order[0] === i) open(i);
        else {
          bringToTop(i);
          renderCrate();
        }
      }),
    );

    stage.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target.closest('[data-close]')) {
        event.preventDefault();
        close();
        return;
      }
      const more = target.closest<HTMLButtonElement>('[data-more]');
      if (more) {
        const row = more.closest('.tl-row')!;
        const expanded = row.classList.toggle('is-expanded');
        more.setAttribute('aria-expanded', String(expanded));
      }
    });

    primary.addEventListener('click', () => (openIndex >= 0 ? close() : open(current)));
    stage.querySelector('[data-prev]')?.addEventListener('click', () => step(-1));
    stage.querySelector('[data-next]')?.addEventListener('click', () => step(1));

    document.addEventListener('keydown', (event) => {
      const el = event.target as HTMLElement;
      if (el.closest('input, textarea, select, [contenteditable]')) return;
      if (lightbox.open) {
        if (event.key === 'Escape') lightbox.close();
        return;
      }
      if (event.key === 'Escape') close();
      else if (event.key === 'ArrowRight' || (event.key === 'ArrowDown' && openIndex < 0)) step(1);
      else if (event.key === 'ArrowLeft' || (event.key === 'ArrowUp' && openIndex < 0)) step(-1);
    });

    window.addEventListener('popstate', () => {
      const slug = location.pathname.match(/\/vinyl-night\/([^/]+)/)?.[1];
      const i = folds.findIndex((f) => f.dataset.slug === slug);
      if (i >= 0) open(i, { push: false, animate: false });
      else close({ push: false });
    });

    // Artifacts can be nudged around the inside of the gatefold with a mouse.
    let lift = 10;
    stage.querySelectorAll<HTMLElement>('[data-artifact]').forEach((card) => {
      let startX = 0;
      let startY = 0;
      let baseX = 0;
      let baseY = 0;
      let dragging = false;
      let moved = false;

      card.addEventListener('click', (event) => {
        if (moved || !card.hasAttribute('data-zoom')) return;
        if ((event.target as HTMLElement).closest('a, button, iframe')) return;
        openLightbox(card);
      });

      card.addEventListener('pointerdown', (event) => {
        moved = false;
        if (event.pointerType !== 'mouse' || event.button !== 0 || flat.matches) return;
        if ((event.target as HTMLElement).closest('a, button, iframe')) return;
        dragging = true;
        startX = event.clientX;
        startY = event.clientY;
        baseX = parseFloat(card.style.getPropertyValue('--tx')) || 0;
        baseY = parseFloat(card.style.getPropertyValue('--ty')) || 0;
        card.style.zIndex = String(++lift);
        card.classList.add('is-dragging');
        card.setPointerCapture?.(event.pointerId);
        event.preventDefault();
      });
      card.addEventListener('pointermove', (event) => {
        if (!dragging) return;
        if (Math.hypot(event.clientX - startX, event.clientY - startY) > 4) moved = true;
        card.style.setProperty('--tx', `${baseX + event.clientX - startX}px`);
        card.style.setProperty('--ty', `${baseY + event.clientY - startY}px`);
      });
      const drop = () => {
        dragging = false;
        card.classList.remove('is-dragging');
      };
      card.addEventListener('pointerup', drop);
      card.addEventListener('pointercancel', drop);
    });

    const lightbox = stage.querySelector<HTMLDialogElement>('[data-lightbox]')!;
    const lightboxMedia = lightbox.querySelector<HTMLElement>('[data-lightbox-media]')!;
    const lightboxCaption = lightbox.querySelector<HTMLElement>('[data-lightbox-caption]')!;
    let pausedVideo: HTMLVideoElement | null = null;

    function openLightbox(card: HTMLElement) {
      const img = card.querySelector('img');
      const video = card.querySelector<HTMLVideoElement>('[data-video]');
      if (img) {
        const big = new Image();
        big.src = img.currentSrc || img.src;
        big.alt = img.alt;
        lightboxMedia.replaceChildren(big);
      } else if (video) {
        const big = document.createElement('video');
        big.src = video.currentSrc || video.src;
        big.poster = video.poster;
        big.controls = true;
        big.playsInline = true;
        big.loop = true;
        big.currentTime = video.currentTime;
        lightboxMedia.replaceChildren(big);
        video.pause();
        pausedVideo = video;
        big.play().catch(() => {});
      } else {
        return;
      }
      const caption = card.querySelector('figcaption');
      lightboxCaption.replaceChildren(...(caption ? [...caption.childNodes].map((n) => n.cloneNode(true)) : []));
      lightbox.showModal();
    }

    lightbox.addEventListener('close', () => {
      lightboxMedia.replaceChildren();
      if (pausedVideo && openIndex >= 0) pausedVideo.play().catch(() => {});
      pausedVideo = null;
    });
    lightbox.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target === lightbox || target.closest('[data-lightbox-close]')) lightbox.close();
    });

    initMenu(stage);
    renderCrate();
  }

  const MENU_KEY = 'vn-menu-v2';

  function initMenu(stage: HTMLElement) {
    const menu = stage.querySelector<HTMLElement>('[data-menu]')!;
    const grip = menu.querySelector<HTMLElement>('[data-menu-grip]')!;
    const fold = menu.querySelector<HTMLButtonElement>('[data-menu-fold]')!;
    const saved = JSON.parse(sessionStorage.getItem(MENU_KEY) ?? 'null') as { x: number; y: number; folded: boolean } | null;
    // On a phone the card is docked along the bottom edge: it starts folded and doesn't drag.
    const phone = window.matchMedia('(max-width: 767.98px), (max-height: 520px)');
    let x = saved?.x ?? 0;
    let y = saved?.y ?? 0;

    // The open spread leaves this much room at the bottom so nothing ends up stuck under the card.
    const measure = () => stage.style.setProperty('--menu-h', `${menu.offsetHeight}px`);
    new ResizeObserver(measure).observe(menu);

    function place() {
      measure();
      if (phone.matches) return;
      const { offsetLeft: left, offsetTop: top, offsetWidth: w, offsetHeight: h } = menu;
      x = Math.min(Math.max(x, 8 - left), stage.clientWidth - 8 - w - left);
      y = Math.min(Math.max(y, 8 - top), stage.clientHeight - 8 - h - top);
      menu.style.setProperty('--mx', `${x}px`);
      menu.style.setProperty('--my', `${y}px`);
    }

    function save() {
      sessionStorage.setItem(MENU_KEY, JSON.stringify({ x, y, folded: preferFolded }));
    }

    function setFolded(folded: boolean) {
      menu.classList.toggle('is-folded', folded);
      fold.textContent = folded ? '(+)' : '(–)';
      fold.setAttribute('aria-expanded', String(!folded));
      fold.setAttribute('aria-label', folded ? 'Unfold the menu' : 'Fold the menu');
      place();
    }

    let preferFolded = saved?.folded ?? phone.matches;
    setFolded(preferFolded);
    fold.addEventListener('click', () => {
      preferFolded = !menu.classList.contains('is-folded');
      setFolded(preferFolded);
      save();
    });

    let startX = 0;
    let startY = 0;
    let baseX = 0;
    let baseY = 0;
    let dragging = false;

    menu.addEventListener('pointerdown', (event) => {
      const target = event.target as HTMLElement;
      if (phone.matches || event.button !== 0 || target.closest('a, button')) return;
      if (event.pointerType !== 'mouse' && !grip.contains(target)) return;
      dragging = true;
      startX = event.clientX;
      startY = event.clientY;
      baseX = x;
      baseY = y;
      menu.classList.add('is-dragging');
      menu.setPointerCapture(event.pointerId);
      event.preventDefault();
    });
    menu.addEventListener('pointermove', (event) => {
      if (!dragging) return;
      x = baseX + event.clientX - startX;
      y = baseY + event.clientY - startY;
      place();
    });
    const drop = () => {
      if (!dragging) return;
      dragging = false;
      menu.classList.remove('is-dragging');
      save();
    };
    menu.addEventListener('pointerup', drop);
    menu.addEventListener('pointercancel', drop);
    window.addEventListener('resize', place);
  }

  const stage = document.querySelector<HTMLElement>('[data-stage]');
  if (stage) initVinylNight(stage);
</script>

